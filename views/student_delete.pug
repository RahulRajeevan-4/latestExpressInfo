extends layout

block content
  h1= title

  p Are you sure you want to delete this student?

  .detail-card
    .detail-row
      strong Name:
      span= student.name
    .detail-row
      strong Email:
      span= student.email

  if enrollments.length
    .error-message
      p Cannot delete this student because they have #{enrollments.length} enrollment(s):
      ul
        each enrollment in enrollments
          li: a(href='/catalog/course/' + enrollment.course)= enrollment.course

  if !enrollments.length
    form(method='POST' action='')
      input(type='hidden' name='studentid' value=student._id)
      .form-actions
        button.btn.btn-danger(type='submit') Delete Student
        a.btn(href=student.url) Cancel
  else
    .form-actions
      a.btn(href='/catalog/students') Back to Students