extends layout

block content
  h1= title
  .detail-card
    .detail-row
      strong Student:
      span: a(href='/catalog/student/' + enrollment.student._id)= enrollment.student.name
    .detail-row
      strong Course:
      span: a(href='/catalog/course/' + enrollment.course._id)= enrollment.course.title
    .detail-row
      strong Status:
      span(class='status-' + enrollment.status.toLowerCase())= enrollment.status
    .detail-row
      strong Enrollment Date:
      span= enrollment.enrollment_date.toISOString().split('T')[0]
  .actions
    a.btn.btn-primary(href=enrollment.url + '/update') Edit Enrollment
    a.btn.btn-danger(href=enrollment.url + '/delete') Delete Enrollment