extends layout

block content
  h1= title

  if errors
    .error-message
      ul
        each error in errors
          li= error.msg

  form(method='POST' action='')
    .form-group
      label(for='title') Title:
      input#title(type='text' name='title' value=course.title required)

    .form-group
      label(for='description') Description:
      textarea#description(name='description' required)= course.description

    .form-group
      label(for='level') Level:
      select#level(name='level' required)
        option(value='Beginner' selected=course.level === 'Beginner') Beginner
        option(value='Intermediate' selected=course.level === 'Intermediate') Intermediate
        option(value='Advanced' selected=course.level === 'Advanced') Advanced

    .form-group
      label(for='duration_weeks') Duration (weeks):
      input#duration_weeks(type='number' name='duration_weeks' value=course.duration_weeks min='1' max='52' required)

    .form-actions
      button.btn.btn-primary(type='submit')= course._id ? 'Update' : 'Create'
      a.btn(href='/catalog/courses') Cancel